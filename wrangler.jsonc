// Cloudflare Worker の設定（P6）。置き方は docs/deploy.md。
// この repo は公開なので、鍵・チームのメールアドレス・Access の値はここに書かず、wrangler secret put で入れる
// （ANTHROPIC_API_KEY・ACCESS_TEAM_DOMAIN・ACCESS_AUD・ALLOWED_EMAILS・ASK_ORIGIN = お客さんの Worker の URL）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dive-passport-demo",
  // worker/index.mjs は default の fetch・scheduled・email のほかに、名前付きの WorkerEntrypoint ShopRpc を export する。
  // redux-ask（wrangler.ask.jsonc）が Service Binding（entrypoint: "ShopRpc"）で呼ぶ。この側に足す設定は無い。**この Worker を先に置く**（docs/deploy.md の 7 節）
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-01",
  // お店の画面の住所は https://app.reduxdive.com（Custom Domain。DNS の行は deploy が作る）。Access の application も app.reduxdive.com に要る（docs/deploy.md の 9）
  "routes": [{ "pattern": "app.reduxdive.com", "custom_domain": true }],
  // 住所は app.reduxdive.com だけ（2026-10-29 に workers.dev を閉じた。名前を REDUX にそろえるため）
  "workers_dev": false,
  // 版ごとの別の URL を作らない（Access を付けた URL のほかに入口を増やさない）
  "preview_urls": false,
  "assets": {
    // node tools/build-site.mjs が作る。repo の中身を丸ごとは置かない
    "directory": "./dist",
    // Worker を通すのは /api だけ。画面のファイルは Static Assets が _headers の CSP を付けて配る
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },
  "d1_databases": [
    // お店の名簿の正本（plan/server.md）とお客さんのリンクの鍵。D1 を持つのはこの Worker だけ（お客さんの Worker は D1 を持たず、ここの ShopRpc を呼ぶ。2026-10-28）。
    // database_id は鍵ではない（wrangler d1 create が出した値）。表は worker/migrations/ を wrangler d1 migrations apply で作る
    { "binding": "DB", "database_name": "redux-rosters", "database_id": "f74f3e8d-7869-4899-9bdf-33c3737a5654", "migrations_dir": "worker/migrations" }
  ],
  "ratelimits": [
    // サイトの予約フォーム（/api/bookings）と、手元の確かめ用の /api/ask の、1 つの IP の回数（plan/auto.md）
    { "name": "BOOKING_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "ASK_LIMIT", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
  ],
  // 書類の自動化: 時刻が来た予定を動かし、連絡を送る（9:00・20:00・6:00 の予定に、遅れても 15 分）。Workers Paid が要る（無料の枠 5 本は使い切り）
  "triggers": { "crons": ["*/15 * * * *"] },
  // お客さんへの連絡を送る（Cloudflare Email Service。Workers Paid が要る）。送り元は決めた 1 つだけに絞る
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["yoyaku@reduxdive.com"] }],
  "kv_namespaces": [
    // 回数と費用の目安を数える。id は wrangler kv namespace create BUDGET が出した値（2026-10-22。id は鍵ではない）
    { "binding": "BUDGET", "id": "6ea53ad88d164c9fad6b855db449d453" },
    // 名簿の毎日の控え（1 年）と警報の記録（worker/backup.mjs。plan/server.md の「毎日の控えと警報」）。D1 とは別の保存場所。
    // id は Cloudflare の API で作った値（2026-10-28、redux-roster-backup。id は鍵ではない）。警報のメールの宛先は secret の ALERT_TO
    { "binding": "BACKUP", "id": "6ce229d7e08d412184cdf7fd8fa7e664" }
  ],
  "vars": {
    // 1 日に AI を呼ぶ回数の上限（日本の日付）と、今月の費用の上限（ドル、目安）。本当の上限は Anthropic のワークスペースで付ける
    "DAILY_LIMIT": "200",
    "MONTHLY_USD": "5",
    // 連絡の送り元と、お店の画面の住所（worker/mail.mjs の mailReady が両方を見る）。お店の画面は app.reduxdive.com（Access の application が要る。docs/deploy.md の 9）。お客さんのリンクの住所は secret の ASK_ORIGIN
    "MAIL_FROM": "yoyaku@reduxdive.com",
    "APP_URL": "https://app.reduxdive.com",
    // 1 店で動かすときの、そのお店の id（今の名簿の行 = default）。D1 の shops が空のとき、これを書いた場合だけ 1 店で動く。無くて空なら 503（開いた側に倒さない）。
    // shops に行を足したら行が先になるので、この行は消してよい（足す前に shops に default の行も入れる: tools/shop.mjs keep-sample）
    "SINGLE_SHOP": "default",
    // 届いたメールの確かめで読む Authentication-Results の名前（Cloudflare が付ける物。2026-10-28 に本番の 1 通で確かめた）
    "MAIL_AUTHSERV_ID": "mx.cloudflare.net"
  },
  // Cloudflare の画面のログに要求を残さない（Worker のログは console.log の 1 行だけで、中身は出さない）
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
