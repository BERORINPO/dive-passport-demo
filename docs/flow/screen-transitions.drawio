<mxfile host="drawio"><diagram id="screens" name="画面遷移図"><mxGraphModel adaptiveColors="auto" dx="2200" dy="1100" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="REDUX 画面遷移図（2026-10-28、main d82fdb1）" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="34" as="geometry"/></mxCell><mxCell id="note" value="上のタブ: お客さま／パスポート／受付／予約と名簿。「デモの画面」でお客さんの画面とお店の画面を切り替える。実線 = 画面の中で移る、点線 = 端末をまたぐ（リンク・メール・データ）。太枠 = 起点の画面、緑の枠 = 10/28 に足した画面、波の形 = 紙に出す画面" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1900" height="30" as="geometry"/></mxCell><mxCell id="laneG" value="お客さんの端末（ログインなし）" style="swimlane;startSize=30;html=1;fillColor=#F2F8FA;strokeColor=#3C6E7E;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="590" height="960" as="geometry"/></mxCell><mxCell id="laneS" value="お店の端末（Cloudflare Access の内側）" style="swimlane;startSize=30;html=1;fillColor=#F7F3EC;strokeColor=#5F6B6E;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="660" y="90" width="1460" height="1720" as="geometry"/></mxCell><mxCell id="g1" value="予約の前に（お客さま タブ）&#xa;ツアー・よく聞かれること（リド）&#xa;日にち・人数・健康の質問" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F0F4;strokeColor=#3C6E7E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="230" height="80" as="geometry"/></mxCell><mxCell id="g2" value="送ったあと&#xa;受け付けた・次にすること" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F0F4;strokeColor=#3C6E7E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="280" width="230" height="80" as="geometry"/></mxCell><mxCell id="mail" value="お客さんに届くメール&#xa;お店の名前で、足りない項目だけ&#xa;（予約の流れの予定どおり自動で届く）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F0F4;strokeColor=#3C6E7E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="540" width="230" height="80" as="geometry"/></mxCell><mxCell id="a1" value="ask.html（お客さんに聞く画面）&#xa;「まだ」の所だけ入れる&#xa;当日の朝に体調を答える" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F0F4;strokeColor=#3C6E7E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="410" width="230" height="80" as="geometry"/></mxCell><mxCell id="p1" value="パスポート タブ&#xa;作る・直す・QR を見せる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F0F4;strokeColor=#3C6E7E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="800" width="230" height="80" as="geometry"/></mxCell><mxCell id="p2" value="pass.html&#xa;読み取り専用（他のお店のスマホ）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F0F4;strokeColor=#3C6E7E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="930" width="230" height="80" as="geometry"/></mxCell><mxCell id="s1" value="受付 タブ&#xa;予約前の確認の一覧・気づく印" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#5F6B6E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="150" width="230" height="80" as="geometry"/></mxCell><mxCell id="l" value="予約の一覧（予約と名簿 タブ）&#xa;便ごとの時刻表・! 確かめる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#11535F;strokeWidth=3;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="410" width="230" height="80" as="geometry"/></mxCell><mxCell id="b10" value="書類の自動化（画面 10）&#xa;送れたか分からない・送れなかった&#xa;読めなかったメール" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#2F6E46;strokeWidth=2;dashed=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="150" width="230" height="80" as="geometry"/></mxCell><mxCell id="f" value="1 件の予約の流れ&#xa;起きたこと・これからの予定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#5F6B6E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="280" width="230" height="80" as="geometry"/></mxCell><mxCell id="m" value="予約メールの取り込み&#xa;貼る → AI に送る前の文面&#xa;（健康の行は外す）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#5F6B6E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="410" width="230" height="80" as="geometry"/></mxCell><mxCell id="ph" value="電話の予約" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#5F6B6E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="540" width="230" height="80" as="geometry"/></mxCell><mxCell id="pt" value="済んだ便（7 日より前）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#5F6B6E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="670" width="230" height="80" as="geometry"/></mxCell><mxCell id="d" value="今日の名簿&#xa;潜水場所・ガイド・そろい具合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#11535F;strokeWidth=3;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="800" width="230" height="80" as="geometry"/></mxCell><mxCell id="ak" value="お客さんに聞くリンク&#xa;リンクを作る・写す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#5F6B6E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="280" width="230" height="80" as="geometry"/></mxCell><mxCell id="pp" value="済んだ便の条例の名簿（紙）" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#5F6B6E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="670" width="230" height="80" as="geometry"/></mxCell><mxCell id="in" value="名簿の取り込み&#xa;申込書・C カードを撮る&#xa;健康の欄を塗る → AI が読む" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#5F6B6E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="800" width="230" height="80" as="geometry"/></mxCell><mxCell id="pr" value="条例の名簿（紙・A4 横）&#xa;印刷・CSV" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#5F6B6E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="930" width="230" height="80" as="geometry"/></mxCell><mxCell id="sp" value="血中酸素を入れる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#5F6B6E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="1060" width="230" height="80" as="geometry"/></mxCell><mxCell id="ca" value="便の中止&#xa;理由・知らせる先・文面" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#5F6B6E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="1190" width="230" height="80" as="geometry"/></mxCell><mxCell id="ics" value="カレンダー（.ics）・記録" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#5F6B6E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="1320" width="230" height="80" as="geometry"/></mxCell><mxCell id="sh" value="乗り合い&#xa;船・船を出す店・乗るお店" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#5F6B6E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="1450" width="230" height="80" as="geometry"/></mxCell><mxCell id="rv" value="確かめる（v12）&#xa;全部の項目をその場で直せる&#xa;健康の 2 項目は直せない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#2F6E46;strokeWidth=2;dashed=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1560" y="800" width="230" height="80" as="geometry"/></mxCell><mxCell id="pa" value="相乗りのお店（その店の役）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#5F6B6E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1560" y="1450" width="230" height="80" as="geometry"/></mxCell><mxCell id="jo" value="合同名簿（船の全員）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#5F6B6E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1560" y="1580" width="230" height="80" as="geometry"/></mxCell><mxCell id="bo" value="船の上で&#xa;お店ごとに「全員戻った」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#5F6B6E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1560" y="1710" width="230" height="80" as="geometry"/></mxCell><mxCell id="ppp" value="相乗りのお店の名簿（紙）" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#5F6B6E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1850" y="1320" width="230" height="80" as="geometry"/></mxCell><mxCell id="pph" value="写真で名前を渡す" st