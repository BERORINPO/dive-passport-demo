// Access を付けない Worker の設定（plan/meibo.md「お客さんのリンク」・plan/auto.md「予約を受ける口」）。
// ask.html と、それが読むファイル（node tools/build-site.mjs が作る dist-ask/）と、/api/ask・/api/walkin・/api/bookings（お店のサイトの予約フォーム）・
// /api/v1/bookings（予約の受け口 API。別のシステムのサーバーから。Authorization の API キー）・/api/health だけを置く。
// この Worker は D1 を持たない（2026-10-28 ask-service-binding。SEC-13）。名簿・鍵の行・お店の一覧は、お店の Worker（wrangler.jsonc）の
// ShopRpc を Service Binding の SHOP で呼ぶ（口は 7 つ: askView・askApply・siteHosts・siteBooking・walkinView・walkinSubmit・intakeBooking。worker/shop-service.mjs）。お店の画面・名簿の道（/api/roster）は置かない。
// secret: TURNSTILE_SECRET を wrangler secret put -c wrangler.ask.jsonc で入れる。サイトの住所（SITE_ORIGINS）と SINGLE_SHOP は、お店の一覧を引くお店の Worker 側に要る
// （この Worker では使わない。前に入れた SITE_ORIGINS は消してよい）。ASK_ORIGIN は使わない。
// 置き方: node tools/build-site.mjs && npx wrangler@4.151.0 deploy -c wrangler.ask.jsonc（docs/deploy.md）。**お店の Worker を先に置く**:
// 相手の Worker が先に無いと、この Worker は置けない。ShopRpc を export する前のお店の Worker に当てると、呼んだ口が無く 500 になる（docs/deploy.md の 7 節）。
// Service Binding の置き順: https://developers.cloudflare.com/workers/runtime-apis/bindings/service-bindings/ の「Deployment」
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redux-ask",
  "main": "worker/ask-index.mjs",
  "compatibility_date": "2026-09-01",
  // 住所は ask.reduxdive.com だけ（2026-10-29 に workers.dev を閉じた）
  "workers_dev": false,
  // お客さんのリンクの住所（reduxdive.com、2026-10-28 に置く）。お店の Worker の secret ASK_ORIGIN もこの住所に変える
  "routes": [{ "pattern": "ask.reduxdive.com", "custom_domain": true }],
  "preview_urls": false,
  "assets": {
    "directory": "./dist-ask",
    // /trial は計測を国で出し分けて Worker が返す（worker/page-serve.mjs。決定ログ 2026-10-29 analytics-country）
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/trial", "/trial.html"],
    "not_found_handling": "none"
  },
  "services": [
    // お店の Worker の ShopRpc（worker/shop-rpc.mjs）。公開の URL も Access も通らない。service はお店の Worker の name（wrangler.jsonc）
    { "binding": "SHOP", "service": "dive-passport-demo", "entrypoint": "ShopRpc" }
  ],
  "ratelimits": [
    // 1 つの IP から /api/ask を呼べる回数（1 分に 30 回）。鍵 1 つの 1 日の回数は、お店の Worker が D1 で数える
    { "name": "ASK_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    // サイトの予約フォームの、1 つの IP の回数（1 分に 5 回）
    { "name": "BOOKING_LIMIT", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } },
    // 予約の受け口 API（/api/v1/bookings）の、1 つの IP の回数（1 分に 60 回。Zapier など共有の出口からも来るので、サイトの予約フォームより広く）。鍵ごとの 1 日の件数はお店の Worker が D1 で数える
    { "name": "INTAKE_LIMIT", "namespace_id": "1005", "simple": { "limit": 60, "period": 60 } }
  ],
  "kv_namespaces": [
    // 1 日の件数（サイトの予約）はお店の Worker が D1 の daily_counts で数える（migration 0006）。KV は Cron が最後に動いた時刻（cron:last）を
    // /api/health が読むためだけに残す（お店の Worker と同じ KV。id は鍵ではない）
    { "binding": "BUDGET", "id": "6ea53ad88d164c9fad6b855db449d453" }
  ],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
